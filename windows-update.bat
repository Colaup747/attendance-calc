@echo off
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference = 'Stop'; [Console]::Title = 'Attendance Planner - 1-Click Installer & Auto-Updater'; Write-Host ''; Write-Host ' ========================================================' -ForegroundColor Cyan; Write-Host '      Attendance Planner - 1-Click Installer & Auto-Updater' -ForegroundColor Cyan; Write-Host ' ========================================================' -ForegroundColor Cyan; Write-Host ''; Write-Host ' [*] Downloading latest version from GitHub...' -ForegroundColor Yellow; try { [Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12; $zipUrl = 'https://github.com/Colaup747/attendance-calc/raw/main/attendance.zip'; $tmpZip = Join-Path $env:TEMP 'attendance_pkg.zip'; $tmpDir = Join-Path $env:TEMP 'attendance_extracted'; if (Test-Path $tmpZip) { Remove-Item $tmpZip -Force }; if (Test-Path $tmpDir) { Remove-Item $tmpDir -Recurse -Force }; Write-Host ' [*] Fetching extension package from GitHub...' -ForegroundColor Cyan; Invoke-WebRequest -Uri $zipUrl -OutFile $tmpZip -UseBasicParsing; Write-Host ' [*] Unpacking extension files...' -ForegroundColor Cyan; Expand-Archive -Path $tmpZip -DestinationPath $tmpDir -Force; $inner = Join-Path $tmpDir 'attendance'; $source = if (Test-Path $inner) { $inner } else { $tmpDir }; Get-ChildItem -Path $source -Filter 'windows-update.bat' -Recurse | Remove-Item -Force -ErrorAction SilentlyContinue; $target = if (Test-Path '%~dp0..\manifest.json') { (Resolve-Path '%~dp0..').Path } else { (Resolve-Path '%~dp0').Path }; Copy-Item -Path (Join-Path $source '*') -Destination $target -Recurse -Force; Remove-Item $tmpZip -Force -ErrorAction SilentlyContinue; Remove-Item $tmpDir -Recurse -Force -ErrorAction SilentlyContinue; Write-Host ' [SUCCESS] Extension files are ready!' -ForegroundColor Green; Write-Host ''; Write-Host ' ========================================================' -ForegroundColor Green; Write-Host '  [SUCCESS] Attendance Planner is ready!' -ForegroundColor Green; Write-Host '  Opening Chrome Extensions page for you...' -ForegroundColor Green; Write-Host ' ========================================================' -ForegroundColor Green; Write-Host ''; Write-Host '  * IF FIRST-TIME INSTALLING:' -ForegroundColor White; Write-Host '    1. Turn ON Developer mode (toggle in top-right of Chrome)' -ForegroundColor Gray; Write-Host '    2. Click Load unpacked' -ForegroundColor Gray; Write-Host '    3. Select your Attendance folder!' -ForegroundColor Gray; Write-Host ''; Write-Host '  * IF UPDATING AN EXISTING INSTALL:' -ForegroundColor White; Write-Host '    * Click the circular Reload arrow on Attendance Planner!' -ForegroundColor Gray; Write-Host ' ========================================================' -ForegroundColor Green; Write-Host ''; $c = (Get-ItemProperty 'HKLM:\Software\Microsoft\Windows\CurrentVersion\App Paths\chrome.exe' -ErrorAction SilentlyContinue).'(default)'; if (-not $c -or !(Test-Path $c)) { $c = (Get-ItemProperty 'HKCU:\Software\Microsoft\Windows\CurrentVersion\App Paths\chrome.exe' -ErrorAction SilentlyContinue).'(default)' }; if (-not $c -or !(Test-Path $c)) { $c = 'C:\Program Files\Google\Chrome\Application\chrome.exe' }; if (-not (Test-Path $c)) { $c = 'C:\Program Files (x86)\Google\Chrome\Application\chrome.exe' }; if (-not (Test-Path $c)) { $c = (Join-Path $env:LOCALAPPDATA 'Google\Chrome\Application\chrome.exe') }; if (Test-Path $c) { Start-Process -FilePath $c -ArgumentList 'chrome://extensions' } else { Start-Process 'cmd' '/c start chrome chrome://extensions' -ErrorAction SilentlyContinue }; Start-Sleep -Seconds 3; exit 0 } catch { Write-Host ''; Write-Host (' [ERROR] ' + $_.Exception.Message) -ForegroundColor Red; Write-Host ' [!] Download or update failed. Please check your internet connection.' -ForegroundColor Yellow; Write-Host ''; Read-Host 'Press [Enter] to exit...'; exit 1 }"
exit /b %ERRORLEVEL%
